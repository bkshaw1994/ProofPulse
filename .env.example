# ==============================================================================
# PROOFPULSE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env for local development. Never commit .env with real credentials.
# All mandatory variables are validated at backend/dashboard startup using Zod schemas.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:5173
WIDGET_CDN_URL=http://localhost:4000/widget/proofpulse.js
LOG_LEVEL=debug

# Frontend Vite specific (prefixed with VITE_ for client bundling)
VITE_API_URL=http://localhost:4000/api/v1
VITE_DASHBOARD_URL=http://localhost:5173
VITE_WIDGET_CDN_URL=http://localhost:4000/widget/proofpulse.js
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE & SUPABASE AUTHENTICATION
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string for Prisma/Drizzle/Kysely/Pg migrations
DATABASE_URL=postgresql://postgres.your-ref:your-db-pass@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-ref:your-db-pass@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase Project API URL & Public Anonymous Key (safe for frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# Supabase Service Role Key (STRICTLY BACKEND ONLY - NEVER EXPOSE TO CLIENT/WIDGET)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# Application Internal Secrets & Encryption
API_KEY_HASH_SALT=your-secure-random-salt-min-32-chars
INTERNAL_SIGNING_SECRET=your-internal-hmac-sha256-signing-secret

# ------------------------------------------------------------------------------
# 3. PAYMENT PROVIDER (RAZORPAY - INDIA SMB FOCUS)
# ------------------------------------------------------------------------------
# Razorpay Key ID (publicly visible on checkout) and Secret (server-side only)
RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourRazorpaySecret
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecret
VITE_RAZORPAY_KEY_ID=rzp_test_yourKeyId

# ------------------------------------------------------------------------------
# 4. THIRD-PARTY E-COMMERCE INTEGRATION WEBHOOK SECRETS
# ------------------------------------------------------------------------------
# Shopify app secret used to verify HMAC-SHA256 signatures on /api/v1/integrations/shopify/webhook
SHOPIFY_WEBHOOK_SECRET=your_shopify_app_client_secret
# WooCommerce / Generic Webhook shared signing secret
WOOCOMMERCE_WEBHOOK_SECRET=your_woocommerce_webhook_secret

# ------------------------------------------------------------------------------
# 5. OBSERVABILITY & ERROR REPORTING
# ------------------------------------------------------------------------------
SENTRY_DSN=
VITE_SENTRY_DSN=

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
WIDGET_RATE_LIMIT_WINDOW_MS=60000
WIDGET_RATE_LIMIT_MAX_REQUESTS=300
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
